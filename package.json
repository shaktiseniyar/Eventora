{
    "private": true,
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev": "concurrently -k -n server,client \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
        "build": "npm run build --workspace=client",
        "start": "npm start --workspace=server"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}